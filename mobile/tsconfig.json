{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    /* The app lives under src/ rather than at the root, so the "@/" alias the
       screens import by has to point there. expo/tsconfig.base sets no
       baseUrl, so these resolve relative to this file. */
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "android", "ios", ".expo"]
}
