# Where the app looks for the API. Without this the build falls back to
# http://localhost:8000/api/v1, which only works while the API runs on the
# same phone — correct for a Termux test, wrong for anything else.
EXPO_PUBLIC_API_URL=https://api.raketdelivery.in/api/v1

# Google sign-in. This is the WEB client id from Google Cloud Console, NOT the
# Android one — counter-intuitive, but it is the audience Google writes into
# the ID token, and it is what the API verifies against. The Android client id
# is read from google-services.json by the native module and never named here.
#
# Leave it empty and the "Continue with Google" button is hidden entirely
# rather than shown and then refused. The API's GOOGLE_CLIENT_IDS has to carry
# this same id, or the server rejects every token it is sent.
#
#   Google Cloud Console → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Web application
#
# You also need an ANDROID OAuth client with the signing key's SHA-1
# fingerprint, or sign-in fails with DEVELOPER_ERROR on the device. Get the
# fingerprint with:
#   keytool -list -v -keystore <your.keystore> -alias <alias>
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
