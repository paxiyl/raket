# Required — the server exits at boot without these.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/onlinemall
JWT_SECRET=change-me-to-a-long-random-string

# Optional, with the defaults shown.
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
# Comma-separated origins for the admin app. Empty allows none.
CORS_ORIGIN=http://localhost:5173
JWT_EXPIRES_IN=7d

# Comma-separated Google OAuth client ids accepted in an ID token's audience.
# Leave empty to turn Google sign-in off, which is the default — both clients
# ask GET /auth/providers and hide the button when it is.
#
# In practice this is ONE id: the WEB client. The admin app uses it directly,
# and the Android app passes it as `webClientId`, so Google writes that same id
# into the `aud` of every token either one sends. The Android OAuth client is
# still required — without it, with the signing key's SHA-1 registered on it,
# the native sign-in is refused with DEVELOPER_ERROR before any token exists —
# but it never appears in an audience, so it does not belong in this list.
GOOGLE_CLIENT_IDS=

# Which gateway checkout uses. Razorpay is the default because it is the only
# one of the two that does UPI, which is how most of Hindaun will pay.
PAYMENT_PROVIDER=razorpay

# Only the payment paths need these; the server boots without them and cash on
# delivery works regardless.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Only image upload needs these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push notifications. A PATH to the Firebase service account JSON on this
# server — never the JSON itself. The file is a private key: anyone holding it
# can send notifications as you and read your project, so it belongs on the
# server with 600 permissions and never in an environment variable, a commit,
# a chat message or a screenshot. Leave empty and push is simply off.
#   Firebase console → Project settings → Service accounts → Generate new key
#   scp it to the server, chmod 600, point this at it.
FIREBASE_SERVICE_ACCOUNT=/etc/raket/firebase-service-account.json
