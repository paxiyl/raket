{
  "name": "api",
  "version": "1.0.0",
  "description": "TypeScript Express API for the MERN delivery platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup",
    "bundle": "tsup",
    "start": "node dist/index.js",
    "seed:categories": "tsx ./src/scripts/seed-categories.ts",
    "seed:restaurants": "tsx ./src/scripts/seed-restaurants.ts",
    "seed:driver": "tsx ./src/scripts/seed-driver.ts",
    "seed:admin": "tsx ./src/scripts/seed-admin.ts",
    "seed:banners": "tsx ./src/scripts/seed-banners.ts",
    "seed:stores": "tsx ./src/scripts/seed-stores.ts",
    "reset:demo": "tsx ./src/scripts/reset-demo-data.ts",
    "link:owner": "tsx ./src/scripts/link-owner.ts",
    "sync:indexes": "tsx ./src/scripts/sync-indexes.ts",
    "check": "tsx ./src/scripts/checks/mobile-routing.check.mjs && tsx ./src/scripts/checks/money.check.mjs && tsx ./src/scripts/checks/payment-availability.check.mjs && tsx ./src/scripts/checks/route-coverage.check.mjs && tsx ./src/scripts/checks/schema-drift.check.mjs && tsx ./src/scripts/checks/index-integrity.check.mjs && tsx ./src/scripts/checks/import-cycles.check.mjs && tsx ./src/scripts/checks/register.check.mjs && tsx ./src/scripts/checks/settlement.check.mjs && tsx ./src/scripts/checks/order-hooks.check.mjs && tsx ./src/scripts/checks/seed.check.mjs && tsx ./src/scripts/checks/reset.check.mjs && tsx ./src/scripts/checks/api.check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "stripe": "^22.6.1",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "nodemon": "^3.1.14",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
