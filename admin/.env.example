# Where the API lives. Without it the app uses http://localhost:8000/api/v1 in
# development and /api/v1 in production.
VITE_API_URL=http://localhost:8000/api/v1

# The WEB OAuth client id from Google Cloud. The sign-in page hides the Google
# button unless this is set AND the server reports Google configured, so a
# button that cannot work is never shown. The client SECRET does not belong
# here — this file is compiled into the browser bundle.
VITE_GOOGLE_CLIENT_ID=
