# Where the API lives. Without it the app uses http://localhost:8000/api/v1 in
# development and /api/v1 in production.
VITE_API_URL=http://localhost:8000/api/v1

# The WEB OAuth client id from Google Cloud. The sign-in page hides the Google
# button unless this is set AND the server reports Google configured, so a
# button that cannot work is never shown. The client SECRET does not belong
# here — this file is compiled into the browser bundle.
#
# READ AT BUILD TIME, NOT AT RUN TIME. Vite compiles this into the bundle, so a
# deployment supplies it as a BUILD ARGUMENT, not a runtime variable, and
# changing it needs a rebuild rather than a restart. On Northflank:
# Configure -> Build -> Build arguments. See NORTHFLANK.md section 5.
#
# This is the single reason the admin Google button has never rendered on a
# deployed build: render.yaml never declared it, so the bundle was always built
# with it undefined. Setup: GOOGLE_SIGNIN_SETUP.md
VITE_GOOGLE_CLIENT_ID=
